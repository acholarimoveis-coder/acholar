# Copie este arquivo para ".env.local" e preencha com as chaves do seu projeto Supabase.
# (Project Settings -> API, no painel do Supabase)

# URL do projeto (ex.: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública "anon" (pode ir no navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta "service_role" (NUNCA exponha no navegador — só no servidor)
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp da administração (usado nos botões "Falar com a administração")
NEXT_PUBLIC_ADMIN_WHATSAPP=5517990000000
